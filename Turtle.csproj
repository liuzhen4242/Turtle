<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 平台条件目标框架：
         Windows Rhino 8.35 = .NET 7 插件模型 → net7.0
         Mac Rhino 8.7 = .NET Framework 4.8 (Mono) 插件模型 → net48 -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net7.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net48</TargetFramework>
    <RootNamespace>Turtle</RootNamespace>
    <AssemblyName>Turtle</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 跨平台：不要加 -windows 后缀，不要用 UseWindowsForms / UseWPF -->
    <Description>Turtle - personal Rhino 8 toolkit</Description>
  </PropertyGroup>

  <!-- Windows: Rhino 8.35 (.NET 7) -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="RhinoCommon" Version="8.*" />
    <PackageReference Include="Grasshopper" Version="8.*" />
  </ItemGroup>

  <!-- Mac: Rhino 8.7 (.NET Framework 4.8 / Mono)。
       直接引用 Mac Rhino 内置的引用程序集（ref/net48，版本 8.7.24138.15432），
       与运行时的 RhinoCommon 完全匹配，避免 NuGet 包（15431）与内置（15432）版本不一致导致无法加载。 -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Reference Include="RhinoCommon">
      <HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources/ref/net48/RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Grasshopper">
      <HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources/ref/net48/Grasshopper.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources/ref/net48/GH_IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- net48 编译需要 reference assemblies -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把 Scripts 文件夹里的 .py 全部嵌入到 .rhp 里 -->
    <EmbeddedResource Include="Scripts\**\*.py" />
    <!-- 改造后的 GH 用户对象（Category=Turtle），安装时写入 GH 用户对象目录 -->
    <EmbeddedResource Include="Grasshopper\Arrows.ghuser" />
    <!-- 命令别名表（KeyTurtle.txt），安装时逐条注册到 Rhino -->
    <EmbeddedResource Include="Resources\KeyTurtle.txt" />
    <!-- 自定义显示模式 ini，安装时释放到 Rhino DisplayModes 目录 -->
    <EmbeddedResource Include="Resources\DisplayStyles\*.ini" />
    <!-- 材质库 rmtl，安装时释放到 Rhino Render Content 目录 -->
    <EmbeddedResource Include="Resources\Materials\*.rmtl" />
    <!-- Turtle 模板 3dm，安装时释放到本地缓存目录 -->
    <EmbeddedResource Include="Resources\Turtle.3dm" />
  </ItemGroup>

  <!-- 编译后自动把 dll 复制成 .rhp，并带上 rui，形成完整可分发文件夹 -->
  <Target Name="MakeRhp" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll"
          DestinationFiles="$(OutDir)$(AssemblyName).rhp" />
    <Copy SourceFiles="Resources\$(AssemblyName).rui"
          DestinationFolder="$(OutDir)"
          Condition="Exists('Resources\$(AssemblyName).rui')" />
    <Message Text="RHP -> $(OutDir)$(AssemblyName).rhp" Importance="high" />
    <Message Text="RUI -> $(OutDir)$(AssemblyName).rui" Importance="high" />
  </Target>

  <!-- Windows 下调试：F5 直接启动 Rhino 8 -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <StartAction>Program</StartAction>
    <StartProgram>C:\Program Files\Rhino 8\System\Rhino.exe</StartProgram>
  </PropertyGroup>

</Project>
