    <macro_item guid="e0f91264-ab79-4082-8855-6d7a7cfe3062" bitmap_id="6dfcdc9e-a295-4e65-a8f3-135f6491c056">
      <text>
        <locale_1033>Macro outline</locale_1033>
      </text>
      <tooltip>
        <locale_1033>outline</locale_1033>
      </tooltip>
      <button_text>
        <locale_1033>轮廓线</locale_1033>
      </button_text>
      <script>_-RunPythonScript (
# -*- coding: utf-8 -*-
import rhinoscriptsyntax as rs
import scriptcontext as sc
import Rhino

def RunMeshOutlineProcess():
    target_layer = "outline"
    linetype_name = "Continuous3"
    
    # 检查并创建新图层（若不存在），设置颜色为黑色
    if not rs.IsLayer(target_layer):
        rs.AddLayer(target_layer, rs.CreateColor(0, 0, 0))
    else:
        rs.LayerColor(target_layer, rs.CreateColor(0, 0, 0))
        
    # 将图层线型显式设置为 Continuous3
    try:
        rs.LayerLinetype(target_layer, linetype_name)
    except Exception:
        pass
        
    # 设置图层的默认打印线宽为 0.2
    layer_index = sc.doc.Layers.FindByFullPath(target_layer, -1)
    if layer_index &gt;= 0:
        layer = sc.doc.Layers[layer_index]
        layer.PlotWeight = 0.2
        layer.CommitChanges()
        
    objs = rs.GetObjects('Select objects to create mesh outline', preselect=True)
    if not objs:
        return
        
    idList = " ".join(["_SelID {}".format(o) for o in objs])
    rs.Command("_MeshOutline " + idList, echo=False)
    newCurves = rs.LastCreatedObjects()
    if not newCurves:
        return
        
    for crv in newCurves:
        rs.Command("_BringToFront _SelID {}".format(crv), echo=False)
        rs.ObjectLayer(crv, target_layer)
        
        # 核心修复：直接将图元自身的线型指定为 Continuous3，并让线型与线宽来源都跟随图层
        obj_ref = sc.doc.Objects.Find(crv)
        if obj_ref:
            attr = obj_ref.Attributes
            attr.LinetypeSource = Rhino.DocObjects.ObjectLinetypeSource.LinetypeFromLayer
            attr.PlotWeightSource = Rhino.DocObjects.ObjectPlotWeightSource.PlotWeightFromLayer
            attr.PlotWeight = 0.2
            sc.doc.Objects.ModifyAttributes(obj_ref, attr, True)
            
        try:
            rs.ObjectLinetype(crv, linetype_name)
        except Exception:
            pass
            
    sc.doc.Views.Redraw()

RunMeshOutlineProcess()
)</script>
    </macro_item>
