    <macro_item guid="a0e254d3-a7e4-4e8b-82d4-3b402ea76f05" bitmap_id="f11fd0e0-4e9b-4aa8-a563-63edd6fb7ea5">
      <text>
        <locale_1033>Macro intersect</locale_1033>
      </text>
      <tooltip>
        <locale_1033>intersect</locale_1033>
      </tooltip>
      <button_text>
        <locale_1033>交线</locale_1033>
      </button_text>
      <script>_-RunPythonScript (
# -*- coding: utf-8 -*-
import rhinoscriptsyntax as rs
import scriptcontext as sc

def RunIntersectAndLayer():
    layer_name = "intersectionCurve"
    
    # 1. 检查并创建图层
    if not rs.IsLayer(layer_name):
        rs.AddLayer(layer_name)
        
    # 2. 在脚本内部调用求交命令（允许用户交互点选）
    rs.Command("_Intersect", echo=True)
    
    # 3. 立即捕获刚刚生成的新对象
    new_objs = rs.LastCreatedObjects()
    if not new_objs:
        return
        
    # 4. 将新生成的交线放入指定图层
    for obj in new_objs:
        rs.ObjectLayer(obj, layer_name)
        
    sc.doc.Views.Redraw()

RunIntersectAndLayer()
)</script>
    </macro_item>
